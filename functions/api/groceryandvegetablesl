
export async function onRequestGet({ env }) {
  if (!env.DB) {
    return Response.json(
      { ok: false, error: "D1 binding DB is missing" },
      { status: 500 }
    );
  }

  try {
    const result = await env.DB
      .prepare("SELECT 1 AS connected")
      .first();

    return Response.json({
      ok: true,
      database: "connected",
      result
    });
  } catch {
    return Response.json(
      { ok: false, error: "Database query failed" },
      { status: 500 }
    );
  }
}
